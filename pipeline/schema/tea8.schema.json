{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tea-8.example/schema/tea8.schema.json",
  "title": "TEA-8 data file",
  "description": "Contract between pipeline/ (writer) and web/ (reader). Changed only from the backend worktree, through a pull request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "simulated", "generated_at", "region", "seasons", "rotations"],
  "properties": {
    "schema_version": { "const": "1" },
    "simulated": {
      "type": "boolean",
      "description": "True when the file holds illustrative data. The interface must label it as simulated."
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "region": { "$ref": "#/$defs/region" },
    "seasons": {
      "type": "array",
      "description": "Summer (June to August) climate summary per year, at the case points.",
      "items": { "$ref": "#/$defs/season" }
    },
    "rotations": {
      "type": "array",
      "description": "Three rotations: the current one and two alternatives.",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/rotation" }
    },
    "limits": {
      "type": "array",
      "description": "Known data limits, shown in the interface.",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "origin": {
      "enum": ["nasa_data", "platform_calculation", "model_text", "citation", "citation_to_verify"],
      "description": "Where a statement or figure comes from. 'citation' is a source that was opened and read; 'citation_to_verify' is one that was not. Every statement carries one."
    },
    "figure": {
      "type": "object",
      "description": "A number with its provenance. value is null when the data is unknown; it is never filled with zero.",
      "additionalProperties": false,
      "required": ["value", "unit", "source", "parameter", "queried_on"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "source": { "type": "string", "minLength": 1, "examples": ["NASA POWER"] },
        "parameter": { "type": "string", "minLength": 1, "examples": ["GWETROOT"] },
        "queried_on": { "type": "string", "format": "date" }
      }
    },
    "statement": {
      "type": "object",
      "description": "One sentence of an explanation with its origin label.",
      "additionalProperties": false,
      "required": ["text", "origin"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/origin" },
        "citation": { "type": "string", "description": "Source reference, when the origin is a citation." }
      }
    },
    "case_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "lon", "lat", "soil", "crop_history"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string" },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "soil": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "drainage", "hydrologic_group", "organic_matter", "available_water"],
          "properties": {
            "name": { "type": "string" },
            "drainage": { "type": "string" },
            "hydrologic_group": { "type": "string" },
            "organic_matter": { "$ref": "#/$defs/figure" },
            "available_water": { "$ref": "#/$defs/figure" }
          }
        },
        "crop_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "crop", "source", "queried_on"],
            "properties": {
              "year": { "type": "integer" },
              "crop": { "type": ["string", "null"] },
              "source": { "type": "string" },
              "queried_on": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "case_points"],
      "properties": {
        "name": { "type": "string" },
        "state": { "type": "string" },
        "case_points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case_point" } }
      }
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "root_wetness", "root_wetness_deviation", "rainfall", "temperature"],
      "properties": {
        "year": { "type": "integer" },
        "root_wetness": { "$ref": "#/$defs/figure" },
        "root_wetness_deviation": { "$ref": "#/$defs/figure" },
        "rainfall": { "$ref": "#/$defs/figure" },
        "temperature": { "$ref": "#/$defs/figure" }
      }
    },
    "rule": {
      "type": "object",
      "description": "A visible, cited rule behind a rotation. Rules are computed by the pipeline; the web app only displays them.",
      "additionalProperties": false,
      "required": ["id", "text", "origin"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/origin" },
        "citation": { "type": "string" }
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "is_current", "hypothetical", "sequence", "rules", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "is_current": { "type": "boolean" },
        "hypothetical": {
          "type": "boolean",
          "description": "True for alternatives that do not exist in the observed fields."
        },
        "sequence": {
          "type": "array",
          "description": "Crops in order, one per year of the cycle.",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["why", "evidence", "gaps", "risks"],
          "properties": {
            "why": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
            "evidence": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
            "gaps": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
            "risks": { "type": "array", "items": { "$ref": "#/$defs/statement" } }
          }
        }
      }
    }
  }
}
