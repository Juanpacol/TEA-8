# URL of the TEA-8 API (Cloud Run). Without it, the question box falls back to the pre-generated explanations.
VITE_API_URL=

# Local dev: ask the deployed API through the Vite proxy (see vite.config.ts). Put both in .env.local.
# VITE_API_PROXY=https://your-cloud-run-url
# VITE_API_URL=http://localhost:5173
